---
const pathName = Astro.url.pathname
const shouldShowName = (pathName !== "/" && !pathName.includes("/writing") && !pathName.includes("artifacts"))
---
<div id="navBar">
    {shouldShowName && <a href="/" id="homeLink">Sam Spinner</a>}
    <div id="navLinks">
        <a href="/about">About</a>
        <a href="/writing">Writing</a>
        <a href="/todo">Todo</a>
    </div>
</div> 
<style>
    a {color: black}

    a:visited {color: black}

    #navLinks {
        display: flex;
        flex-direction: row;
        justify-content: right;
        gap: 1rem;
        width: 100%;
    }

    #homeLink {
        font-weight: 550;
        width: 100%;
    }

    #homeLink:hover {
        text-decoration: none;
    }

    #navBar {
        display: flex;
        justify-content: space-between;
	margin-bottom: 3rem;
    }
</style>
