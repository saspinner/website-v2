---
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"
const pageTitle = "About"
import headshot from "../img/cropped.png"
const imgWidth = 200

---
<BaseLayout pageTitle={pageTitle}>
    <div id="aboutSection">
        <div>
		An auto-prebituary. "Just for me", as much as is possible with a public website. I suggest you first visit <a href="/switchboard">/switchboard</a> which is certain to contain media more worth your time. 
        <div>
            <Image src={headshot} alt="Here is what I look like" width={imgWidth} loading="lazy"/>
		Here is what I look like:
        </div>
    </div>
</BaseLayout>

<style>
    #aboutSection {
        display: flex;
        flex-direction: row;
        gap: 5rem;
        align-content: space-evenly;
    }

    @media only screen and (max-width: 600px) {
        #aboutSection {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            align-content: space-evenly;
        }

  }
</style>
   
